<view class="container">
  <view style="{{imageStyle}}">
    <image src="../images/ic_launcher.png" class="login-img"></image>
  </view>
  <view class="login-from">

    <!--账号-->
    <view class="input-container">
      <view class="input-row">
        <text>账号</text>
      </view>
      <view class="input-row">
        <input type="text" placeholder="请输入邮箱" bindinput="phoneInput"/>
      </view>
      
      <view class="input-row">
        <text>密码</text>
      </view>
      <view class="input-row">
        <input type="password" placeholder="请输入密码" bindinput="passwordInput"/>
      </view>
    </view>
    <view class="line"></view>

    <!--按钮-->
    <view class="loginBtnView">
      <button class="loginBtn" type="primary" size="{{primarySize}}" loading="{{loading}}" plain="{{plain}}" disabled="{{disabled}}" bindtap="next" data-phone="{{phone}}" data-password="{{password}}">下一步</button>
    </view>
  </view>
</view>